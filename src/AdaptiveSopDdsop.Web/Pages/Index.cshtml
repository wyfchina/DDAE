@page
@model IndexModel
@{
    ViewData["Title"] = "场景运行工作台";
}

<div id="scenario-workspace-app" class="app-shell">
    <aside id="primary-navigation" class="navigation" aria-label="主导航">
        <div class="brand-block">
            <div class="brand-mark" aria-hidden="true">DD</div>
            <div class="brand-copy">
                <strong>DDAE</strong>
                <span>需求驱动 S&OP 工作台</span>
            </div>
        </div>
        <nav class="nav-list">
            <span class="nav-group-label">主业务流程</span>
            <div class="nav-stage-group" data-stage-id="history-review-panel">
                <button class="nav-stage-toggle nav-item" type="button" data-stage-route="#history-review-panel" aria-expanded="true" aria-controls="history-review-submenu" data-help-key="historyReview"><span class="nav-index">01</span><span>历史回顾</span><span class="nav-stage-indicator" aria-hidden="true"></span></button>
                <div id="history-review-submenu" class="nav-submenu">
                    <a class="nav-subitem" href="#history-review-panel/operating-results">经营结果</a>
                    <a class="nav-subitem" href="#history-review-panel/buffer-performance">缓冲表现</a>
                    <a class="nav-subitem" href="#history-review-panel/sizing-trace">定容追溯</a>
                    <a class="nav-subitem" href="#history-review-panel/capacity-constraints">能力约束</a>
                </div>
            </div>
            <div class="nav-stage-group" data-stage-id="current-baseline-panel">
                <button class="nav-stage-toggle nav-item" type="button" data-stage-route="#current-baseline-panel" aria-expanded="false" aria-controls="current-baseline-submenu" data-help-key="currentBaseline"><span class="nav-index">02</span><span>当前状态基线</span><span class="nav-stage-indicator" aria-hidden="true"></span></button>
                <div id="current-baseline-submenu" class="nav-submenu" hidden>
                    <a class="nav-subitem" href="#current-baseline-panel/meeting-snapshot">会前快照</a>
                    <a class="nav-subitem" href="#current-baseline-panel/evidence-review">证据检查</a>
                    <a class="nav-subitem" href="#current-baseline-panel/version-freeze">版本冻结</a>
                    <a class="nav-subitem" href="#current-baseline-panel/audit-records">审计记录</a>
                </div>
            </div>
            <div class="nav-stage-group" data-stage-id="future-scenario-panel">
                <button class="nav-stage-toggle nav-item" type="button" data-stage-route="#future-scenario-panel" aria-expanded="false" aria-controls="future-scenario-submenu" data-help-key="futureScenario"><span class="nav-index">03</span><span>未来场景模拟</span><span class="nav-stage-indicator" aria-hidden="true"></span></button>
                <div id="future-scenario-submenu" class="nav-submenu" hidden>
                    <a class="nav-subitem" href="#future-scenario-panel/scenario-config">场景配置</a>
                    <a class="nav-subitem" href="#future-scenario-panel/plan-comparison">方案比较</a>
                    <a class="nav-subitem" href="#future-scenario-panel/inventory-buffer">库存缓冲</a>
                    <a class="nav-subitem" href="#future-scenario-panel/time-buffer">时间缓冲</a>
                    <a class="nav-subitem" href="#future-scenario-panel/capacity-buffer">能力缓冲</a>
                    <a class="nav-subitem" href="#future-scenario-panel/supply-risk">供应风险</a>
                    <a class="nav-subitem" href="#future-scenario-panel/breach-analysis">击穿分析</a>
                </div>
            </div>
            <div class="nav-stage-group" data-stage-id="ddom-decision-panel">
                <button class="nav-stage-toggle nav-item" type="button" data-stage-route="#ddom-decision-panel" aria-expanded="false" aria-controls="ddom-decision-submenu" data-help-key="ddomDecision"><span class="nav-index">04</span><span>DDOM 配置决策</span><span class="nav-stage-indicator" aria-hidden="true"></span></button>
                <div id="ddom-decision-submenu" class="nav-submenu" hidden>
                    <a class="nav-subitem" href="#ddom-decision-panel/structure-settings">结构设置</a>
                    <a class="nav-subitem" href="#ddom-decision-panel/parameter-decision">参数决策</a>
                    <a class="nav-subitem" href="#ddom-decision-panel/temporary-adjustment">临时调整</a>
                    <a class="nav-subitem" href="#ddom-decision-panel/change-records">变更记录</a>
                </div>
            </div>
            <div class="nav-stage-group" data-stage-id="coordination-panel">
                <button class="nav-stage-toggle nav-item" type="button" data-stage-route="#coordination-panel" aria-expanded="false" aria-controls="coordination-submenu" data-help-key="coordination"><span class="nav-index">05</span><span>行动和决策</span><span class="nav-stage-indicator" aria-hidden="true"></span></button>
                <div id="coordination-submenu" class="nav-submenu" hidden>
                    <a class="nav-subitem" href="#coordination-panel/issue-list">问题清单</a>
                    <a class="nav-subitem" href="#coordination-panel/action-tracking">行动跟踪</a>
                    <a class="nav-subitem" href="#coordination-panel/decision-records">决策记录</a>
                    <a class="nav-subitem" href="#coordination-panel/outcome-validation">结果验证</a>
                </div>
            </div>
            <span class="nav-group-label validation-group">验证与追踪</span>
            <a class="nav-item" href="#trace-panel" data-help-key="whiteBoxTrace"><span class="nav-index">V1</span><span>白盒追踪</span></a>
            <a class="nav-item" href="#public-demo-golden-loop-panel" data-help-key="publicDemoGoldenLoop"><span class="nav-index">V2</span><span>公开演示闭环</span></a>
        </nav>
        <div class="navigation-footer">
            <span class="service-dot" aria-hidden="true"></span>
            <span>本地数据源已连接</span>
        </div>
    </aside>

    <div class="application-area">
        <header class="top-context">
            <div class="top-context-leading">
                <button id="navigation-toggle" class="icon-button" type="button" aria-label="切换导航">&#9776;</button>
                <div class="factory-context">
                    <span class="context-label">计划范围</span>
                    <strong>卫星制造企业</strong>
                </div>
            </div>
            <div class="context-strip" aria-label="计划上下文">
                <div class="context-item">
                    <span class="context-label">主数据版本</span>
                    <strong id="master-data-version">演示数据-2026-06</strong>
                </div>
                <div class="context-item">
                    <span class="context-label">运行快照</span>
                    <strong id="snapshot-freshness">未加载</strong>
                </div>
                <div class="context-item">
                    <span class="context-label">系统健康</span>
                    <strong id="system-health" class="status-inline is-loading">检查中</strong>
                </div>
            </div>
            <div class="top-actions">
                <button id="refresh-workspace" class="button secondary" type="button">刷新</button>
                <div class="user-context">
                    <span class="user-avatar" aria-hidden="true">PL</span>
                    <span><strong>计划员</strong><small>计划角色</small></span>
                </div>
            </div>
        </header>

        <main id="workspace" class="workspace" tabindex="-1">
            <div class="page-heading">
                <div>
                    <p class="eyebrow">DDAE 五阶段工作台</p>
                    <nav id="workspace-breadcrumb" class="workspace-breadcrumb" aria-label="当前位置"></nav>
                    <h1>需求驱动 S&OP 场景运行工作台</h1>
                    <p class="page-description">从历史证据、冻结基线、未来场景、DDOM 决策到行动验证形成闭环；模拟结果不会自动批准、生效或发布。</p>
                </div>
                <span id="route-status" class="status-chip neutral">正在加载</span>
            </div>

            <section id="workspace-loading" class="readiness-banner is-loading" aria-live="polite">
                <div>
                    <span class="context-label">数据状态</span>
                    <strong>正在读取场景工作台数据</strong>
                    <p>当前阶段支持场景预览重算、候选动作组合选择、场景留痕和主设置变更治理。</p>
                </div>
            </section>

            <div id="workspace-error" class="persistent-error" role="alert" hidden>
                <strong>无法读取场景工作台数据</strong>
                <span id="workspace-error-message">请检查本地服务后刷新。</span>
            </div>

            <section id="history-review-panel" class="workspace-section stage-workspace workspace-route-view" data-workspace-route="#history-review-panel" hidden>
                <div class="stage-heading">
                    <div><span class="stage-number">01</span><p class="panel-kicker">从实际结果建立事实</p><h2>历史回顾</h2></div>
                </div>
                <div class="readiness-banner">
                    <div><span class="context-label">阶段目标</span><strong>以历史实际结果识别保护有效性和能力约束</strong><p>经营结果、缓冲表现、定容追溯和能力约束分别查看；六个月与十二个月窗口按累计提前期证据独立汇总。</p></div>
                </div>
            </section>

            <section id="history-buffer-performance-view" class="workspace-section workspace-route-view" data-workspace-route="#history-review-panel/buffer-performance" hidden>
                <div class="panel-heading">
                    <div><span class="panel-kicker">历史回顾</span><h2>缓冲表现</h2></div>
                    <div class="panel-inline-actions history-range-control" aria-label="缓冲表现历史范围">
                        <button class="button secondary is-selected" type="button" data-history-range-months="6" aria-pressed="true">近六个月</button>
                        <button class="button secondary" type="button" data-history-range-months="12" aria-pressed="false">近十二个月</button>
                    </div>
                </div>
                <div id="history-buffer-overview" class="rccp-kpis" aria-label="历史缓冲概览"></div>
                <div class="history-buffer-layout">
                    <aside class="history-object-options" aria-label="历史缓冲选择">
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">库存对象</span><h2>控制点与 SKU</h2></div></div>
                            <div id="history-inventory-control-point-options" class="history-selector-group" aria-label="库存控制点"></div>
                            <div id="history-inventory-sku-options" class="history-selector-group" aria-label="库存 SKU"></div>
                        </section>
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">时间对象</span><h2>时间缓冲</h2></div></div>
                            <div id="history-time-buffer-options" class="history-selector-group" aria-label="时间缓冲对象"></div>
                        </section>
                    </aside>
                    <div class="history-object-options">
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">库存缓冲</span><h2>水位与区域历史</h2></div></div>
                            <div id="history-inventory-chart" class="history-chart" aria-label="历史库存缓冲图" aria-live="polite"></div>
                        </section>
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">时间缓冲</span><h2>五段时效与异常费用</h2></div></div>
                            <div id="history-time-buffer-chart" class="history-chart" aria-label="历史时间缓冲图" aria-live="polite"></div>
                        </section>
                    </div>
                </div>
                <div class="stage-grid two-column">
                    <section class="stage-card">
                        <div class="panel-heading compact-heading"><div><span class="panel-kicker">控制点—保护关系</span><h2>设计、可用与有效性证据</h2></div></div>
                        <div class="table-scroll"><table class="data-table"><thead><tr><th>控制点</th><th>保护对象</th><th>保护类型</th><th>设计</th><th>可用</th><th>有效</th><th>证据</th></tr></thead><tbody id="history-protection-body"></tbody></table></div>
                    </section>
                    <section class="stage-card">
                        <div class="panel-heading compact-heading"><div><span class="panel-kicker">区域停留时长</span><h2>红黄绿保护带历史</h2></div></div>
                        <div class="table-scroll"><table class="data-table"><thead><tr><th>SKU</th><th>观察期</th><th>红区</th><th>黄区</th><th>绿区</th><th>连续红区</th><th>恢复周期</th><th>主要原因</th></tr></thead><tbody id="history-zone-body"></tbody></table></div>
                    </section>
                </div>
            </section>

            <section id="history-sizing-trace-view" class="workspace-section workspace-route-view" data-workspace-route="#history-review-panel/sizing-trace" hidden>
                <div class="panel-heading">
                    <div><span class="panel-kicker">历史回顾</span><h2>定容追溯</h2></div>
                    <div class="panel-inline-actions history-range-control" aria-label="定容追溯历史范围">
                        <button class="button secondary is-selected" type="button" data-history-range-months="6" aria-pressed="true">近六个月</button>
                        <button class="button secondary" type="button" data-history-range-months="12" aria-pressed="false">近十二个月</button>
                    </div>
                </div>
                <div class="history-buffer-layout">
                    <aside class="history-object-options" aria-label="历史定容选择">
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">定容对象</span><h2>控制点、SKU 与快照</h2></div></div>
                            <div id="history-sizing-control-point-options" class="history-selector-group" aria-label="定容控制点"></div>
                            <div id="history-sizing-sku-options" class="history-selector-group" aria-label="定容 SKU"></div>
                            <div id="history-sizing-snapshot-options" class="history-selector-group" aria-label="定容快照"></div>
                        </section>
                    </aside>
                    <div class="history-object-options">
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">快照参数</span><h2>DDMRP 输入摘要</h2></div></div>
                            <div id="history-ddmrp-input-summary" class="metadata-list"></div>
                        </section>
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">后端定容证据</span><h2>公式、输入与结果</h2></div></div>
                            <div class="table-scroll"><table class="data-table"><thead><tr><th>组成</th><th>公式</th><th>值</th><th>证据</th></tr></thead><tbody id="history-ddmrp-sizing-body"></tbody></table></div>
                        </section>
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">区域结构</span><h2>红黄绿定容区</h2></div></div>
                            <div id="history-ddmrp-zone-chart" class="history-chart" aria-label="历史 DDMRP 定容区图" aria-live="polite"></div>
                            <p class="history-evidence-note">所选快照只展示其当期参数与证据，不用当前参数回填历史缺口。</p>
                        </section>
                    </div>
                </div>
            </section>

            <section id="history-capacity-constraints-view" class="workspace-section workspace-route-view" data-workspace-route="#history-review-panel/capacity-constraints" hidden>
                <div class="panel-heading">
                    <div><span class="panel-kicker">历史回顾</span><h2>能力约束</h2></div>
                    <div class="panel-inline-actions history-range-control" aria-label="能力约束历史范围">
                        <button class="button secondary is-selected" type="button" data-history-range-months="6" aria-pressed="true">近六个月</button>
                        <button class="button secondary" type="button" data-history-range-months="12" aria-pressed="false">近十二个月</button>
                    </div>
                </div>
                <div class="history-buffer-layout">
                    <aside class="history-object-options">
                        <section class="history-visual-card">
                            <div class="panel-heading compact-heading"><div><span class="panel-kicker">能力对象</span><h2>资源选择</h2></div></div>
                            <div id="history-capacity-resource-options" class="history-selector-group" aria-label="历史能力资源"></div>
                        </section>
                    </aside>
                    <section class="history-visual-card">
                        <div class="panel-heading compact-heading"><div><span class="panel-kicker">期间能力</span><h2>AIT 上游保护与 CCR 利用率参照</h2></div></div>
                        <div id="history-capacity-buffer-chart" class="history-chart" aria-label="历史能力缓冲图" aria-live="polite"></div>
                    </section>
                </div>
                <div class="stage-grid two-column">
                    <section class="stage-card">
                        <div class="panel-heading compact-heading"><div><span class="panel-kicker">能力分层</span><h2>负荷、阈值与保护消耗</h2></div></div>
                        <div id="history-capacity-layers" class="capacity-layer-list"></div>
                    </section>
                    <section class="stage-card">
                        <div class="panel-heading compact-heading"><div><span class="panel-kicker">约束分类</span><h2>CCR、潜在 CCR、事件与外部约束</h2></div></div>
                        <div class="table-scroll"><table class="data-table"><thead><tr><th>类型</th><th>对象</th><th>状态</th><th>负荷</th><th>证据</th></tr></thead><tbody id="history-constraint-body"></tbody></table></div>
                    </section>
                </div>
            </section>

            <section id="current-baseline-panel" class="workspace-section stage-workspace workspace-route-view" data-workspace-route="#current-baseline-panel" hidden>
                <div class="stage-heading">
                    <div><span class="stage-number">02</span><p class="panel-kicker">冻结可追溯的当前事实</p><h2>当前状态基线</h2></div>
                </div>
                <div class="readiness-banner">
                    <div><span class="context-label">阶段目标</span><strong>先检查证据，再冻结不可变会前事实</strong><p>会前快照、证据检查、版本冻结和审计记录分别查看；缺失证据不得按零处理。</p></div>
                </div>
            </section>

            <section id="baseline-evidence-review-view" class="workspace-section workspace-route-view" data-workspace-route="#current-baseline-panel/evidence-review" hidden>
                <div class="panel-heading"><div><span class="panel-kicker">当前状态基线</span><h2>证据检查</h2></div></div>
                <section class="stage-card">
                    <div class="panel-heading compact-heading"><div><span class="panel-kicker">候选证据</span><h2 id="baseline-candidate-title">来源、新鲜度与完整性</h2></div></div>
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>部分</th><th>来源</th><th>截止时间</th><th>新鲜度</th><th>完整性</th><th>条目</th><th>证据</th><th>缺失原因</th></tr></thead><tbody id="baseline-evidence-body"></tbody></table></div>
                </section>
            </section>

            <section id="baseline-version-freeze-view" class="workspace-section workspace-route-view" data-workspace-route="#current-baseline-panel/version-freeze" hidden>
                <div class="panel-heading"><div><span class="panel-kicker">当前状态基线</span><h2>版本冻结</h2></div></div>
                <div class="readiness-banner">
                    <div><span class="context-label">冻结规则</span><strong>关键证据缺失时禁止冻结；缺失不得按零处理</strong><p>冻结快照不可编辑，只能基于新截止时间生成下一版本。演示适配器数据明确标记为“演示数据”。</p></div>
                    <div class="baseline-freeze-actions">
                        <input id="baseline-created-by" type="text" value="DDS&OP 计划员" aria-label="冻结人">
                        <input id="baseline-note" type="text" placeholder="冻结说明" aria-label="冻结说明">
                        <button id="freeze-current-baseline" class="button primary" type="button">冻结新版本</button>
                    </div>
                </div>
                <section class="stage-card">
                    <div class="panel-heading compact-heading"><div><span class="panel-kicker">不可变版本</span><h2>已冻结基线</h2></div></div>
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>编号</th><th>截止时间</th><th>主设置版本</th><th>创建人</th><th>完整度</th><th>状态</th></tr></thead><tbody id="baseline-snapshot-body"></tbody></table></div>
                </section>
            </section>

            <section id="baseline-audit-records-view" class="workspace-section workspace-route-view" data-workspace-route="#current-baseline-panel/audit-records" hidden>
                <div class="panel-heading"><div><span class="panel-kicker">当前状态基线</span><h2>审计记录</h2></div></div>
                <div id="baseline-audit-list" class="diagnostics-list"></div>
                <section class="stage-card baseline-reference-card">
                    <div class="panel-heading compact-heading"><div><span class="panel-kicker">只读关联</span><h2>场景、配置与行动</h2></div></div>
                    <div id="baseline-reference-list" class="diagnostics-list"></div>
                </section>
            </section>

            <section id="future-scenario-panel" class="workspace-section stage-workspace workspace-route-view" data-workspace-route="#future-scenario-panel" hidden>
                <div class="stage-heading">
                    <div><span class="stage-number">03</span><p class="panel-kicker">同源基线，多响应对照</p><h2>未来场景模拟</h2></div>
                    <span id="future-compare-status" class="status-chip neutral">等待配置</span>
                </div>
                <div class="scenario-separation-grid">
                    <section class="stage-card"><div class="panel-heading compact-heading"><div><span class="panel-kicker">外部场景</span><h2>不可控条件</h2></div></div><p>需求变化、供应风险、能力损失和已知事件作为外部假设，与企业响应分开记录。</p></section>
                    <section class="stage-card"><div class="panel-heading compact-heading"><div><span class="panel-kicker">响应方案</span><h2>人工可控措施</h2></div></div><p>同一冻结基线与外部场景下，比较不采取措施和多个响应方案；结果不会自动进入治理或执行。</p></section>
                </div>
                <div class="stage-deep-links" aria-label="未来场景深度视图"><a href="#future-scenario-panel/scenario-config">配置场景</a><a href="#future-scenario-panel/plan-comparison">比较方案</a><a href="#future-scenario-panel/breach-analysis">查看击穿</a></div>
            </section>

